<?xml version="1.0" encoding="UTF-8"?>
<project name="KrelavoStore" default="jar" basedir=".">
  <property name="build.dir" value="build"/>
  <property name="classes.dir" value="build/classes"/>
  <property name="dist.dir" value="dist"/>
  <property name="jdk8.home" value="C:/Program Files/Java/jdk1.8.0_202"/>
  <property name="krelavo.envio.cop" value="0"/>
  <path id="dependency.classpath">
    <pathelement location="lib/sqlite-jdbc-3.45.3.0.jar"/>
    <pathelement location="lib/slf4j-api-1.7.36.jar"/>
    <pathelement location="lib/slf4j-nop-1.7.36.jar"/>
  </path>
  <path id="application.classpath">
    <pathelement location="${classes.dir}"/>
    <path refid="dependency.classpath"/>
  </path>
  <target name="clean"><delete dir="${build.dir}"/><delete dir="${dist.dir}"/></target>
  <target name="compile">
    <mkdir dir="${classes.dir}"/>
    <javac srcdir="src" destdir="${classes.dir}" source="1.8" target="1.8" encoding="UTF-8" includeantruntime="false" fork="true" executable="${jdk8.home}/bin/javac.exe">
      <classpath refid="dependency.classpath"/>
    </javac>
    <copy todir="${classes.dir}"><fileset dir="src"><exclude name="**/*.java"/></fileset></copy>
  </target>
  <target name="jar" depends="compile">
    <mkdir dir="${dist.dir}"/>
    <mkdir dir="${dist.dir}/lib"/>
    <copy todir="${dist.dir}/lib">
      <fileset dir="lib" includes="sqlite-jdbc-3.45.3.0.jar,slf4j-api-1.7.36.jar,slf4j-nop-1.7.36.jar"/>
    </copy>
    <jar destfile="dist/KrelavoStore.jar" manifest="manifest.mf"><fileset dir="${classes.dir}"/></jar>
  </target>
  <target name="run" depends="compile">
    <java classname="krelavo.store.Main" fork="true" failonerror="true" jvm="${jdk8.home}/bin/java.exe"><sysproperty key="krelavo.envio.cop" value="${krelavo.envio.cop}"/><classpath refid="application.classpath"/></java>
  </target>
  <target name="verify" depends="compile">
    <mkdir dir="build/verification"/>
    <javac srcdir="verification" destdir="build/verification" source="1.8" target="1.8" encoding="UTF-8" includeantruntime="false" fork="true" executable="${jdk8.home}/bin/javac.exe">
      <classpath refid="application.classpath"/>
    </javac>
    <java classname="krelavo.store.VerificacionMigraciones" fork="true" failonerror="true" jvm="${jdk8.home}/bin/java.exe">
      <sysproperty key="krelavo.db.path" value="build/verification/krelavo-refactor.db"/>
      <classpath><pathelement location="build/verification"/><path refid="application.classpath"/></classpath>
    </java>
    <java classname="krelavo.store.VerificacionIntegracion" fork="true" failonerror="true" jvm="${jdk8.home}/bin/java.exe">
      <classpath><pathelement location="build/verification"/><path refid="application.classpath"/></classpath>
    </java>
  </target>
</project>
